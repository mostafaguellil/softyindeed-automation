# Identifiants (ne jamais committer le fichier .env réel)
INDEED_EMAIL=clavaleeroffey@globe-group.com
INDEED_PASSWORD=Lavallee01*
SOFTY_EMAIL=croffey
SOFTY_PASSWORD=Lavallee01*

# URLs de connexion
INDEED_LOGIN_URL=https://employers.indeed.com/jobs
SOFTY_LOGIN_URL=https://v2.softy.pro/login?redirect=%2F

# Colonnes référence offre : "auto" (recommandé) ou nom exact de l'en-tête
# Propositions probables :
#   Softy  → Id de l'offre, Référence, Numéro offre
#   Indeed → Reference Number, Job Reference, Job ID
INDEED_REFERENCE_COLUMN=auto
SOFTY_REFERENCE_COLUMN=auto

# Mode navigateur : headless=true pour exécution silencieuse
HEADLESS=false

# --- Mode Chrome attaché (contourne le 2FA Indeed) ---
USE_CDP=true
CDP_PORT=9222
CDP_URL=http://localhost:9222
CDP_WAIT_SECONDS=60
# Windows: leave empty or ignore /tmp path — LANCER uses %TEMP%
CHROME_USER_DATA_DIR=
INDEED_ATTACH_URL=employers.indeed.com
SOFTY_ATTACH_URL=softy.pro

# Dossier de sortie des exports téléchargés
DOWNLOAD_DIR=./downloads
